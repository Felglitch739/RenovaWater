{
  "expo": {
    "name": "T.P.H Monitor",
    "slug": "tph-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/TPH_MonitorLogo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/TPH_MonitorLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/TPH_MonitorLogo.png",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "TPH Monitor requiere acceso a Bluetooth BLE para conectarse al microcontrolador ESP32 y recibir telemetría del sensor de pH.",
        "NSBluetoothPeripheralUsageDescription": "TPH Monitor requiere acceso a Bluetooth para comunicación con la sonda ESP32."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/TPH_MonitorLogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "da2dbb08-9b8b-4efe-95a9-35c011d228a8"
      }
    },
    "owner": "felixemfs-organization",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/da2dbb08-9b8b-4efe-95a9-35c011d228a8"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "TPH Monitor requiere acceso a Bluetooth BLE para comunicarse con el ESP32."
        }
      ]
    ]
  }
}
