{
  "expo": {
    "name": "T.P.H Monitor",
    "slug": "tph-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/TPH_MonitorLogo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/TPH_MonitorLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/TPH_MonitorLogo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/TPH_MonitorLogo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
